"Лоша локација претраге\n"
"Покушавам да претражим фасциклу %1"

#: kio_filenamesearch.cpp:538
#, kde-format
msgctxt "@info:status"
msgid ""
"Invalid search query: '%1'\n"
"Expected a regular expression: %2"
msgstr ""
"Лош упит претраге: „%1“\n"
"Очекиван је регуларни израз: %2"

#: kio_filenamesearch.cpp:818
#, kde-format
msgctxt "@info:%1 is the program used to do the search"
msgid "%1 failed, exit code: %2, error messages: %3"
msgstr "Програм %1 није успео, излазни кôд: %2, поруке о грешкама: %3"
