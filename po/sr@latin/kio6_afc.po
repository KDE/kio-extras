#: afcutils.cpp:105
#, kde-format
msgid ""
"The device is locked. Please enter the passcode on the device and try again."
msgstr ""
"Uređaj je zaključan. Unesite kod za otključavanje na uređaju i pokušajte "
"ponovo."

#: afcutils.cpp:112
#, kde-format
msgid "You have denied this computer access to the device."
msgstr "Odbili ste ovom računaru pristup uređaju."

#: afcutils.cpp:119
#, kde-format
msgid ""
"You need to allow this computer to access the device. Please accept the "
"prompt on the device and try again."
msgstr ""
"Morate dozvoliti ovom računaru da pristupi uređaju. Prihvatite upit na "
"uređaju i pokušajte ponovo."

#: afcutils.cpp:127
#, kde-format
msgid ""
"Cannot access the device. Make sure it is unlocked and allows this computer "
"to access it."
msgstr ""
"Ne mogu da pristupim uređaju. Proverite da li je otključan i da li "
"dozvoljava ovom računaru pristup."

#: afcutils.cpp:134
#, kde-format
msgid "Unhandled lockdownd code '%1'"
msgstr "Neobrađen kôd lockdownd „%1“"

#: afcutils.cpp:147
#, kde-format
msgid "Unhandled sbservices code '%1'"
msgstr "Neobrađen kôd sbservices „%1“"

#: kio_afc.cpp:137
#, kde-format
msgid "Apple Devices"
msgstr "Appleovi uređaji"

#: kio_afc.cpp:193 kio_afc.cpp:413
#, kde-format
msgctxt "Link to folder with files stored inside apps"
msgid "Apps"
msgstr "Programi"

#: kio_afc.cpp:617
#, kde-format
msgid "Cannot read without opening file first"
msgstr "Ne mogu da čitam bez prethodnog otvaranja fajla"

#: kio_afc.cpp:637
#, kde-format
msgid "Cannot seek without opening file first"
msgstr "Ne mogu da premotavam bez prethodnog otvaranja fajla"

#: kio_afc.cpp:665
#, kde-format
msgid "Cannot write without opening file first"
msgstr "Ne mogu da pišem bez prethodnog otvaranja fajla"

#: kio_afc.cpp:817
#, kde-format
msgid "Cannot rename between devices."
msgstr "Ne mogu da preimenujem između uređaja."
