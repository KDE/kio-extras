msgid "Could not read link: %1 [%2]"
msgstr "ئۇلانمىنى ئوقۇيالمىدى: %1 [%2]"

#: kio_sftp.cpp:651
#, kde-format
msgid "Could not create a new SSH session."
msgstr "يېڭى SSH جەريانچاقنى قۇرغىلى بولمىدى."

#: kio_sftp.cpp:662 kio_sftp.cpp:666
#, kde-format
msgid "Could not set a timeout."
msgstr "قەرەلنى تەڭشىيەلمىدى."

#: kio_sftp.cpp:673
#, kde-format
msgid "Could not disable Nagle's Algorithm."
msgstr "Nagle ھېسابلاش ئۇسۇلىنى چەكلىيەلمەيدۇ."

#: kio_sftp.cpp:679 kio_sftp.cpp:684
#, kde-format
msgid "Could not set compression."
msgstr "قىسىشنى تەڭشىيەلمەيدۇ."

#: kio_sftp.cpp:690
#, kde-format
msgid "Could not set host."
msgstr "كومپيۇتېرنى تەڭشىيەلمەيدۇ."

#: kio_sftp.cpp:696
#, kde-format
msgid "Could not set port."
msgstr "ئېغىزنى تەڭشىيەلمەيدۇ."

#: kio_sftp.cpp:704
#, kde-format
msgid "Could not set username."
msgstr "ئىشلەتكۈچى ئاتىنى تەڭشىيەلمەيدۇ."

#: kio_sftp.cpp:711
#, kde-format
msgid "Could not parse the config file."
msgstr "سەپلىمە ھۆججەتنى تەھلىل قىلالمىدى."

#: kio_sftp.cpp:726
#, kde-kuit-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "كومپيۇتېر %1:%2 غا SFTP باغلىنىشىنى ئېچىۋاتىدۇ"

#: kio_sftp.cpp:766
#, kde-format
msgid "Could not get server public key type name"
msgstr "مۇلازىمېتىر ئاممىۋى ئاچقۇچ تۈرىنىڭ ئىسمىغا ئېرىشەلمەيدۇ"

#: kio_sftp.cpp:778
#, kde-format
msgid "Could not create hash from server public key"
msgstr "مۇلازىمېتىر ئاممىۋى ئاچقۇچىدىن مۇكەممەللىك قىممىتى قۇرالمايدۇ"

#: kio_sftp.cpp:787
#, kde-format
msgid "Could not create fingerprint for server public key"
msgstr "مۇلازىمېتىر ئاممىۋى ئاچقۇچىدىن بارماق ئىزى قۇرالمايدۇ"

#: kio_sftp.cpp:846
#, kde-format
msgid ""
"An %1 host key for this server was not found, but another type of key "
"exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%2"
msgstr ""
"بۇ مۇلازىمېتىرنىڭ %1 مۇلازىمېتىر ئاچقۇچىنى تاپالمىدى ئەمما باشقا تۈردىكى "
"ئاچقۇچ مەۋجۇت.\n"
"بەلكىم ھۇجۇمچى مۇلازىمېتىرنىڭ كۆڭۈلدىكى مۇلازىمېتىر ئاچقۇچىنى ئۆزگەرتىۋېتىپ "
"خېرىدارنى ئاچقۇچ يوق دەپ قارىشىغا قىزىقتۇرماقچى بولۇشى مۇمكىن.\n"
"سىستېما باشقۇرغۇچى بىلەن ئالاقىلىشىڭ.\n"
"%2"

#: kio_sftp.cpp:863
#, kde-format
msgctxt "@title:window"
msgid "Host Identity Change"
msgstr "مۇلازىمېتىر كىملىكى ئۆزگەردى"

#: kio_sftp.cpp:865
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The host key for the server <emphasis>%1</emphasis> has changed.</"
"para><para>This could either mean that DNS spoofing is happening or the IP "
"address for the host and its host key have changed at the same time.</"
"para><para>The %2 key fingerprint sent by the remote host is:<bcode>%3</"
"bcode>Are you sure you want to continue connecting?</para>"
msgstr ""
"<para>مۇلازىمېتىر <emphasis>%1</emphasis> نىڭ مۇلازىمېتىر ئاچقۇچى ئۆزگەردى.</"
"para><para>بۇ بەلكىم DNS ئالدامچىلىقىدىن كېلىپ چىققان بولۇشى مۇمكىن، بەلكىم "
"مەزكۇر مۇلازىمېتىرنىڭ IP ئادرېسى ۋە مۇلازىمېتىر ئاچقۇچى بىرلا ۋاقىتتا "
"ئۆزگەرگەن بولۇشى مۇمكىن.</para><para>يىراقتىكى مۇلازىمېتىر يوللىغان %2 "
"ئاچقۇچ بارماق ئىزى: <bcode>%3</bcode> باغلىنىشنى داۋاملاشتۇرامسىز؟</para>"

#: kio_sftp.cpp:875
#, kde-format
msgctxt "@title:window"
msgid "Host Verification Failure"
msgstr "مۇلازىمېتىرنى دەلىللىيەلمىدى"

#: kio_sftp.cpp:877
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The authenticity of host <emphasis>%1</emphasis> cannot be established."
"</para><para>The %2 key fingerprint is:<bcode>%3</bcode>Are you sure you "
"want to continue connecting?</para>"
msgstr ""
"<para>مۇلازىمېتىر <emphasis>%1</emphasis> نىڭ ئىشەنچلىكلىكىنى دەلىللىيەلمىدى."
"</para><para>مۇلازىمېتىر %2 نىڭ بارماق ئىزى:<bcode>%3</bcode>باغلىنىشنى "
"داۋاملاشتۇرامسىز؟</para>"

#: kio_sftp.cpp:886
#, kde-format
msgctxt "@action:button"
msgid "Connect Anyway"
msgstr "باغلىنىۋەر"

#: kio_sftp.cpp:909 kio_sftp.cpp:928 kio_sftp.cpp:949 kio_sftp.cpp:962
#: kio_sftp.cpp:1014 kio_sftp.cpp:1024
#, kde-format
msgid "Authentication failed."
msgstr "دەلىللىيەلمىدى."

#: kio_sftp.cpp:916
#, kde-format
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr "دەلىللىيەلمىدى. مۇلازىمېتىر ھېچقانداق دەلىللەش ئۇسۇلىنى يوللىمىدى"

#: kio_sftp.cpp:971
#, kde-format
msgid "Please enter your username and password."
msgstr "ئىشلەتكۈچى ئاتى ۋە ئىم كىرگۈزۈڭ."

#: kio_sftp.cpp:982
#, kde-format
msgid "Incorrect username or password"
msgstr "ئىشلەتكۈچى ئاتى ياكى ئىم توغرا ئەمەس"

#: kio_sftp.cpp:1031
#, kde-format
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"SFTP تارماق سىستېمىنى ئىلتىماس قىلالمىدى. مۇلازىمېتىردا SFTP نىڭ "
"قوزغىتىلغانلىقىنى جەزملەڭ."

#: kio_sftp.cpp:1036
#, kde-format
msgid "Could not initialize the SFTP session."
msgstr "SFTP جەريانچاقنى دەسلەپلەشتۈرەلمىدى."

#: kio_sftp.cpp:1040
#, kde-format
msgid "Successfully connected to %1"
msgstr "%1 غا مۇۋەپپەقىيەتلىك باغلاندى"

#: kio_sftp.cpp:1093
#, kde-format
msgid "Invalid sftp context"
msgstr "SFTP مەزمۇنى ئىناۋەتسىز"

#: kio_sftp.cpp:1637
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"تۆۋەندىكىنىڭ ھوقۇقىنى ئۆزگەرتكىلى بولمىدى\n"
"%1"

