msgstr "خاتىرە دەرىجىسىنى بەلگىلىگىلى بولمىدى."

#: kio_sftp.cpp:383
#, kde-format
msgid "Could not set log userdata."
msgstr "خاتىرە ئىشلەتكۈچى سانلىق مەلۇماتىنى تەڭشىگىلى بولمىدى."

#: kio_sftp.cpp:388
#, kde-format
msgid "Could not set log callback."
msgstr "خاتىرە چاقىرىق ئىنكاسىنى تەڭشىگىلى بولمىدى."

#: kio_sftp.cpp:424 kio_sftp.cpp:426 kio_sftp.cpp:970
#, kde-format
msgid "SFTP Login"
msgstr "SFTP تىزىمغا كىرىش"

#: kio_sftp.cpp:441
#, kde-format
msgid "Use the username input field to answer this question."
msgstr ""
"بۇ سوئالغا جاۋاب بېرىشتە ئىشلەتكۈچى ئاتىنى كىرگۈزۈش سۆز بۆلىكىنى ئىشلىتىدۇ."

#: kio_sftp.cpp:454
#, kde-format
msgid "Please enter your password."
msgstr "ئىم كىرگۈزۈڭ."

#: kio_sftp.cpp:459 kio_sftp.cpp:973
#, kde-format
msgid "Site:"
msgstr "تور بېكەت:"

#: kio_sftp.cpp:520
#, kde-format
