#: kio_man.cpp:1409
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Could not find the <command>%1</command> program on your system. Please "
"install it if necessary, and ensure that it can be found using the "
"environment variable <envar>PATH</envar>."
msgstr ""
"Nepavyko jūsų sistemoje rasti programos <command>%1</command>. Įsidiekite "
"ją, jei reikia, ir įsitikinkite, kad ją galima rasti naudojant aplinkos "
"kintamąjį <envar>PATH</envar>."

