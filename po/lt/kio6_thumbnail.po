#: thumbnail.cpp:292
#, kde-format
msgid "No MIME Type specified."
msgstr "Nenurodytas MIME tipas."

#: thumbnail.cpp:299
#, kde-format
msgid "No or invalid size specified."
msgstr "Dydis nenurodytas arba nurodytas neteisingai."

#: thumbnail.cpp:324
#, kde-format
msgid "Cannot create thumbnail for directory"
msgstr "Nepavyksta sukurti miniatiūros katalogui"

#: thumbnail.cpp:333
#, kde-format
msgid "No plugin specified."
msgstr "Nenurodytas įskiepis."

#: thumbnail.cpp:338
#, kde-format
msgid "Cannot load ThumbCreator %1"
msgstr "Nepavyksta įkelti ThumbCreator %1"

#: thumbnail.cpp:346
#, kde-format
msgid "Cannot create thumbnail for %1"
msgstr "Nepavyksta sukurti miniatiūros, skirtos %1"

#: thumbnail.cpp:356
#, kde-format
msgid "Failed to create a thumbnail."
msgstr "Nepavyko sukurti miniatiūros."

#: thumbnail.cpp:376
#, kde-format
msgid "Could not write image."
msgstr "Nepavyko įrašyti atvaizdo."

#: thumbnail.cpp:404
#, kde-format
msgid "Failed to attach to shared memory segment %1"
msgstr "Nepavyko pridėti prie bendrinamo atminties segmento %1"

#: thumbnail.cpp:408
#, kde-format
msgid "Image is too big for the shared memory segment"
msgstr "Atvaizdas per didelis bendrinamam atminties segmentui"

#~ msgctxt "@option:check"
#~ msgid "Rotate the image automatically"
#~ msgstr "Automatiškai pasukti nuotrauką"
