#: webshortcuts/ikwsopts.cpp:104
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid "Check to select this web search keyword as preferred."
msgstr "Zvolte toto klíčové slovo pro vyhledávání na webu jako preferované."

#: webshortcuts/ikwsopts.cpp:224
#, kde-format
msgctxt "@item:inlistbox No default web search keyword"
msgid "None"
msgstr "Nic"

#: webshortcuts/ikwsopts.cpp:269
#, kde-format
msgid "Search F&ilters"
msgstr "F&iltry pro vyhledávání"

#: webshortcuts/ikwsopts.cpp:299
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Web search keywords allow you to quickly search or look up words on "
"the Internet. They work in Plasma's <application>KRunner</application> "
"search, <application>Konqueror</application>'s address bar, and in any other "
"applications that support them. For example, to search for information about "
"the KDE project using the Google search engine, you can simply type "
"<icode>gg:KDE</icode> or <icode>google:KDE</icode>.</para>"
msgstr ""
"<para>Klíčová slova pro vyhledávání na webu vám umožňují rychle vyhledávat "
"nebo dohledávat slova na internetu. Fungují ve vyhledávači "
"<application>KRunner</application> v prostředí Plasma, v adresním řádku "
"<application>Konqueroru</application> a v jakýchkoli dalších aplikacích, "
"které je podporují. Chcete-li například vyhledat informace o projektu KDE "
"pomocí vyhledávače Google, stačí zadat <icode>gg:KDE</icode> nebo "
"<icode>google:KDE</icode>.</para>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cbEnableShortcuts)
#: webshortcuts/ikwsopts_ui.ui:17
#, kde-format
msgid ""
"Check to recognise and use the web search keywords in applications that can "
"use them"
msgstr ""
"Zvolte si, zda dokážete rozpoznat a používat klíčová slova pro vyhledávání "
"na webu v aplikacích, které je podporují"

#. i18n: ectx: property (text), widget (QCheckBox, cbEnableShortcuts)
#: webshortcuts/ikwsopts_ui.ui:20
#, kde-format
msgid "&Enable Web search keywords"
msgstr "&Povolit klíčová slova webového vyhledávání"

#. i18n: ectx: property (text), widget (QLabel, lbQuickHelp)
#: webshortcuts/ikwsopts_ui.ui:36
#, kde-format
msgid "<a href=\"whatsthis\">How do these work?</a>"
msgstr "<a href=\"whatsthis\">Jak to funguje?</a>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, cbUseSelectedShortcutsOnly)
#: webshortcuts/ikwsopts_ui.ui:52
#, kde-format
msgid ""
"<p>Check to only use the preferred web search keywords, as selected in the "
"list below, where necessary.</p><p>If this is checked, then applications "
"that can only show a limited number of search keywords (for example, "
"Konqueror when text on a page is selected) will only show the preferred "
"keywords.</p>"
msgstr ""
"<p>Zaškrtněte toto políčko, chcete-li v případě potřeby používat pouze "
"preferovaná klíčová slova pro vyhledávání na webu, vybraná v níže uvedeném "
"seznamu.</p><p>Je-li toto políčko zaškrtnuto, aplikace, které mohou zobrazit "
"pouze omezený počet klíčových slov pro vyhledávání (například Konqueror při "
"výběru textu na stránce), budou zobrazovat pouze preferovaná klíčová slova.</"
"p>"

#. i18n: ectx: property (text), widget (QCheckBox, cbUseSelectedShortcutsOnly)
#: webshortcuts/ikwsopts_ui.ui:55
#, kde-format
msgid "&Use preferred keywords only"
msgstr "Po&užít pouze preferovaná klíčová slova"

