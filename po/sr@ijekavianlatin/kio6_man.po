#: kio_man.cpp:517
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No man page matching <resource>%1</resource> could be found.<nl/><nl/>Check "
"that you have not mistyped the name of the page, and note that man page "
"names are case sensitive.<nl/><nl/>If the name is correct, then you may need "
"to extend the search path for man pages, either using the <envar>MANPATH</"
"envar> environment variable or a configuration file in the <filename>/etc</"
"filename> directory."
msgstr ""
"Nije nađena nijedna uputna stranica koja odgovara <resource>%1</resource>."
"<nl/><nl/>Provjerite da niste pogrešno unijeli ime stranice i imajte u vidu "
"da se u imenima uputnih stranica razlikuju velika i mala slova.<nl/><nl/>Ako "
"je ime ispravno, možda morate da proširite putanju traženja uputnih "
"stranica, ili promjenljivom okruženja <envar>MANPATH</envar> ili postavnim "
"fajlom u fascikli <filename>/etc</filename>."

#: kio_man.cpp:632
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The specified man page references another page <filename>%1</filename>,<nl/"
">but the referenced page <filename>%2</filename> could not be found."
msgstr ""
"Zadata uputna stranica upućuje na drugu stranicu <filename>%1</filename>,<nl/"
">ali stranica na koju upućuje, <filename>%2</filename>, nije nađena."

#: kio_man.cpp:649
#, kde-kuit-format
msgctxt "@info"
msgid "The man page <filename>%1</filename> could not be read."
msgstr "Ne mogu da pročitam uputnu stranicu <filename>%1</filename>."

#: kio_man.cpp:658
#, kde-kuit-format
msgctxt "@info"
msgid "The man page <filename>%1</filename> could not be converted."
msgstr "Ne mogu da pretvorim uputnu stranicu <filename>%1</filename>."

#: kio_man.cpp:713
#, kde-format
msgid "Manual Page Viewer Error"
msgstr "Greška prikazivača uputnih stranica"

#: kio_man.cpp:747
#, kde-format
msgid "Multiple Manual Pages"
msgstr "Više uputnih stranica"

#: kio_man.cpp:748
#, kde-format
msgid "There is more than one matching man page:"
msgstr "Više od jedne uputne stranice odgovara upitu:"

#: kio_man.cpp:749
#, kde-format
msgid ""
"Note: if you read a man page in your language, be aware it can contain some "
"mistakes or be obsolete. In case of doubt, you should have a look at the "
"English version."
msgstr ""
"Napomena: Ako čitate uputnu stranicu na svom jeziku, imajte na umu da može "
"imati neke greške ili biti zastarjela. Ako posumnjate, pogledajte i englesku "
"verziju."

#: kio_man.cpp:757
#, kde-format
msgid "Possible Alternative Manual Pages"
msgstr "Moguće alternativne uputne stranice"

#: kio_man.cpp:758
#, kde-format
msgid "There were possible close matches:"
msgstr "Ima mogućih bliskih poklapanja:"

#: kio_man.cpp:760
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No man page matching <resource>%1</resource> could be found, but there were "
"close or case insensitive matches as above."
msgstr ""
"Nije nađena nijedna uputna stranica koja odgovara <resource>%1</resource>, "
"ali ima bliskih poklapanja ili poklapanja bez obzira na veličinu slova, kao "
"iznad."

