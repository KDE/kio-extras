#: forgetfileitemaction.cpp:55
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Remove the selected file(s) or location(s) from the recently used list in "
"Dolphin and in Plasma's menus. This does not remove or move the resource(s)."
msgstr ""
"Uklanja izabrane fajlove ili lokacije sa spiska nedavno korišćenih u "
"Dolphinu i u menijima Plasme. Ovo ne uklanja niti premiješta same resurse."

