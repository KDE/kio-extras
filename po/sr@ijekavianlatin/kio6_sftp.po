#: kio_sftp.cpp:316
#, kde-format
msgid "Incorrect or invalid passphrase"
msgstr "Netačna ili nevažeća lozinka"

#: kio_sftp.cpp:365
#, kde-format
msgid "Could not allocate callbacks"
msgstr "Ne mogu da rezervišem kontrapozive."

#: kio_sftp.cpp:378
#, kde-format
msgid "Could not set log verbosity."
msgstr "Ne mogu da postavim opširnost bilježenja."

#: kio_sftp.cpp:383
#, kde-format
msgid "Could not set log userdata."
msgstr "Ne mogu da postavim korisničke podatke bilježenja."

#: kio_sftp.cpp:388
#, kde-format
msgid "Could not set log callback."
msgstr "Ne mogu da postavim kontrapoziv bilježenja."

#: kio_sftp.cpp:424 kio_sftp.cpp:426 kio_sftp.cpp:979
#, kde-format
msgid "SFTP Login"
msgstr "SFTP prijavljivanje"

#: kio_sftp.cpp:441
#, kde-format
msgid "Use the username input field to answer this question."
msgstr "Na ovo pitanje odgovorite u polju za unos korisničkog imena."

#: kio_sftp.cpp:456
#, kde-format
msgid "Please enter your password."
msgstr "Unesite lozinku."

#: kio_sftp.cpp:461 kio_sftp.cpp:982
#, kde-format
msgid "Site:"
msgstr "Sajt:"

#: kio_sftp.cpp:524
#, kde-format
msgctxt "error message. %1 is a path, %2 is a numeric error code"
msgid "Could not read link: %1 [%2]"
msgstr "Ne mogu da čitam vezu: %1 [%2]"

#: kio_sftp.cpp:655
#, kde-format
msgid "Could not create a new SSH session."
msgstr "Ne mogu da napravim novu SSH sesiju."

#: kio_sftp.cpp:666 kio_sftp.cpp:670
#, kde-format
msgid "Could not set a timeout."
msgstr "Ne mogu da postavim prekovrijeme."

#: kio_sftp.cpp:677
#, kde-format
msgid "Could not disable Nagle's Algorithm."
msgstr "Ne mogu da isključim Nejglov algoritam."

#: kio_sftp.cpp:683 kio_sftp.cpp:688
#, kde-format
msgid "Could not set compression."
msgstr "Ne mogu da postavim kompresiju."

#: kio_sftp.cpp:694
#, kde-format
msgid "Could not set host."
msgstr "Ne mogu da postavim domaćin."

#: kio_sftp.cpp:700
#, kde-format
msgid "Could not set port."
msgstr "Ne mogu da postavim port."

#: kio_sftp.cpp:708
#, kde-format
msgid "Could not set username."
msgstr "Ne mogu da postavim korisničko ime."

#: kio_sftp.cpp:715
#, kde-format
msgid "Could not parse the config file."
msgstr "Ne mogu da raščlanim postavni fajl."

#: kio_sftp.cpp:730
#, kde-kuit-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Otvaram SFTP vezu ka domaćinu %1:%2"

#: kio_sftp.cpp:770
#, kde-format
msgid "Could not get server public key type name"
msgstr "Ne mogu da dobavim ime tipa javnog ključa servera"

#: kio_sftp.cpp:782
#, kde-format
msgid "Could not create hash from server public key"
msgstr "Ne mogu da napravim disperziju javnog ključa servera"

#: kio_sftp.cpp:791
#, kde-format
msgid "Could not create fingerprint for server public key"
msgstr "Ne mogu da napravim otisak javnog ključa servera"

#: kio_sftp.cpp:850
#, kde-format
msgid ""
"An %1 host key for this server was not found, but another type of key "
"exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%2"
msgstr ""
"Ključ domaćina tipa %1 za ovaj server nije nađen, ali postoji drugi tip "
"ključa.\n"
"Napadač bi mogao da promijeni podrazumijevani ključ servera tako da vaš "
"klijent pomisli da ključ ne postoji.\n"
"Obratite se sistem-administratoru.\n"
"%2"

#: kio_sftp.cpp:867
#, kde-format
msgctxt "@title:window"
msgid "Host Identity Change"
msgstr "Promjena identiteta domaćina"

#: kio_sftp.cpp:869
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The host key for the server <emphasis>%1</emphasis> has changed.</"
"para><para>This could either mean that DNS spoofing is happening or the IP "
"address for the host and its host key have changed at the same time.</"
"para><para>The %2 key fingerprint sent by the remote host is:<bcode>%3</"
"bcode>Are you sure you want to continue connecting?</para>"
msgstr ""
"<para>Ključ domaćina za server <emphasis>%1</emphasis> izmijenjen je.</"
"para><para>Ovo znači da je ili došlo do DNS varke, ili su i IP adresa i "
"ključ domaćina istovremeno promijenjeni.</para><para>Udaljeni domaćin šalje "
"ključ tipa %2 sa otiskom:<bcode>%3</bcode>Želite li zaista da nastavite s "
"povezivanjem?</para>"

#: kio_sftp.cpp:879
#, kde-format
msgctxt "@title:window"
msgid "Host Verification Failure"
msgstr "Neuspjela provjera domaćina"

#: kio_sftp.cpp:881
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The authenticity of host <emphasis>%1</emphasis> cannot be established."
"</para><para>The %2 key fingerprint is:<bcode>%3</bcode>Are you sure you "
"want to continue connecting?</para>"
msgstr ""
"<para>Autentičnost domaćina <emphasis>%1</emphasis> ne može da se uspostavi."
"</para><para>Otisak ključa tipa %2 je:<bcode>%3</bcode>Želite li zaista da "
"nastavite s povezivanjem?</para>"

#: kio_sftp.cpp:890
#, kde-format
msgctxt "@action:button"
msgid "Connect Anyway"
msgstr "Ipak se poveži"

#: kio_sftp.cpp:913 kio_sftp.cpp:932 kio_sftp.cpp:953 kio_sftp.cpp:971
#: kio_sftp.cpp:1023 kio_sftp.cpp:1033
#, kde-format
msgid "Authentication failed."
msgstr "Autentifikacija nije uspjela."

#: kio_sftp.cpp:920
#, kde-format
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr ""
"Autentifikacija nije uspjela. Server nije poslao nijedan metod "
"autentifikacije."

#: kio_sftp.cpp:980
#, kde-format
msgid "Please enter your username and password."
msgstr "Unesite svoje korisničko ime i lozinku."

#: kio_sftp.cpp:991
#, kde-format
msgid "Incorrect username or password"
msgstr "Pogrešno korisničko ime ili lozinka"

#: kio_sftp.cpp:1040
#, kde-format
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Ne mogu da zatražim SFTP podsistem. Postarajte se da je SFTP uključen na "
"serveru."

#: kio_sftp.cpp:1045
#, kde-format
msgid "Could not initialize the SFTP session."
msgstr "Ne mogu da pripremim SFTP sesiju."

#: kio_sftp.cpp:1049
#, kde-format
msgid "Successfully connected to %1"
msgstr "Uspješno uspostavljena veza sa %1"

#: kio_sftp.cpp:1106
#, kde-format
msgid "Invalid sftp context"
msgstr "Loš SFTP kontekst"

#: kio_sftp.cpp:1655
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Ne mogu da promijenim dozvole za\n"
"%1"
