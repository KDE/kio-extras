#: kio_sftp.cpp:316
#, kde-format
msgid "Incorrect or invalid passphrase"
msgstr "Нетачна или неважећа лозинка"

#: kio_sftp.cpp:365
#, kde-format
msgid "Could not allocate callbacks"
msgstr "Не могу да резервишем контрапозиве."

#: kio_sftp.cpp:378
#, kde-format
msgid "Could not set log verbosity."
msgstr "Не могу да поставим опширност биљежења."

#: kio_sftp.cpp:383
#, kde-format
msgid "Could not set log userdata."
msgstr "Не могу да поставим корисничке податке биљежења."

#: kio_sftp.cpp:388
#, kde-format
msgid "Could not set log callback."
msgstr "Не могу да поставим контрапозив биљежења."

#: kio_sftp.cpp:424 kio_sftp.cpp:426 kio_sftp.cpp:979
#, kde-format
msgid "SFTP Login"
msgstr "СФТП пријављивање"

#: kio_sftp.cpp:441
#, kde-format
msgid "Use the username input field to answer this question."
msgstr "На ово питање одговорите у пољу за унос корисничког имена."

#: kio_sftp.cpp:456
#, kde-format
msgid "Please enter your password."
msgstr "Унесите лозинку."

#: kio_sftp.cpp:461 kio_sftp.cpp:982
#, kde-format
msgid "Site:"
msgstr "Сајт:"

#: kio_sftp.cpp:524
#, kde-format
msgctxt "error message. %1 is a path, %2 is a numeric error code"
msgid "Could not read link: %1 [%2]"
msgstr "Не могу да читам везу: %1 [%2]"

#: kio_sftp.cpp:655
#, kde-format
msgid "Could not create a new SSH session."
msgstr "Не могу да направим нову ССХ сесију."

#: kio_sftp.cpp:666 kio_sftp.cpp:670
#, kde-format
msgid "Could not set a timeout."
msgstr "Не могу да поставим прековријеме."

#: kio_sftp.cpp:677
#, kde-format
msgid "Could not disable Nagle's Algorithm."
msgstr "Не могу да искључим Нејглов алгоритам."

#: kio_sftp.cpp:683 kio_sftp.cpp:688
#, kde-format
msgid "Could not set compression."
msgstr "Не могу да поставим компресију."

#: kio_sftp.cpp:694
#, kde-format
msgid "Could not set host."
msgstr "Не могу да поставим домаћин."

#: kio_sftp.cpp:700
#, kde-format
msgid "Could not set port."
msgstr "Не могу да поставим порт."

#: kio_sftp.cpp:708
#, kde-format
msgid "Could not set username."
msgstr "Не могу да поставим корисничко име."

#: kio_sftp.cpp:715
#, kde-format
msgid "Could not parse the config file."
msgstr "Не могу да рашчланим поставни фајл."

#: kio_sftp.cpp:730
#, kde-kuit-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Отварам СФТП везу ка домаћину %1:%2"

#: kio_sftp.cpp:770
#, kde-format
msgid "Could not get server public key type name"
msgstr "Не могу да добавим име типа јавног кључа сервера"

#: kio_sftp.cpp:782
#, kde-format
msgid "Could not create hash from server public key"
msgstr "Не могу да направим дисперзију јавног кључа сервера"

#: kio_sftp.cpp:791
#, kde-format
msgid "Could not create fingerprint for server public key"
msgstr "Не могу да направим отисак јавног кључа сервера"

#: kio_sftp.cpp:850
#, kde-format
msgid ""
"An %1 host key for this server was not found, but another type of key "
"exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%2"
msgstr ""
"Кључ домаћина типа %1 за овај сервер није нађен, али постоји други тип "
"кључа.\n"
"Нападач би могао да промијени подразумијевани кључ сервера тако да ваш "
"клијент помисли да кључ не постоји.\n"
"Обратите се систем-администратору.\n"
"%2"

#: kio_sftp.cpp:867
#, kde-format
msgctxt "@title:window"
msgid "Host Identity Change"
msgstr "Промјена идентитета домаћина"

#: kio_sftp.cpp:869
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The host key for the server <emphasis>%1</emphasis> has changed.</"
"para><para>This could either mean that DNS spoofing is happening or the IP "
"address for the host and its host key have changed at the same time.</"
"para><para>The %2 key fingerprint sent by the remote host is:<bcode>%3</"
"bcode>Are you sure you want to continue connecting?</para>"
msgstr ""
"<para>Кључ домаћина за сервер <emphasis>%1</emphasis> измијењен је.</"
"para><para>Ово значи да је или дошло до ДНС варке, или су и ИП адреса и кључ "
"домаћина истовремено промијењени.</para><para>Удаљени домаћин шаље кључ типа "
"%2 са отиском:<bcode>%3</bcode>Желите ли заиста да наставите с повезивањем?</"
"para>"

#: kio_sftp.cpp:879
#, kde-format
msgctxt "@title:window"
msgid "Host Verification Failure"
msgstr "Неуспјела провјера домаћина"

#: kio_sftp.cpp:881
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The authenticity of host <emphasis>%1</emphasis> cannot be established."
"</para><para>The %2 key fingerprint is:<bcode>%3</bcode>Are you sure you "
"want to continue connecting?</para>"
msgstr ""
"<para>Аутентичност домаћина <emphasis>%1</emphasis> не може да се успостави."
"</para><para>Отисак кључа типа %2 је:<bcode>%3</bcode>Желите ли заиста да "
"наставите с повезивањем?</para>"

#: kio_sftp.cpp:890
#, kde-format
msgctxt "@action:button"
msgid "Connect Anyway"
msgstr "Ипак се повежи"

#: kio_sftp.cpp:913 kio_sftp.cpp:932 kio_sftp.cpp:953 kio_sftp.cpp:971
#: kio_sftp.cpp:1023 kio_sftp.cpp:1033
#, kde-format
msgid "Authentication failed."
msgstr "Аутентификација није успјела."

#: kio_sftp.cpp:920
#, kde-format
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr ""
"Аутентификација није успјела. Сервер није послао ниједан метод "
"аутентификације."

#: kio_sftp.cpp:980
#, kde-format
msgid "Please enter your username and password."
msgstr "Унесите своје корисничко име и лозинку."

#: kio_sftp.cpp:991
#, kde-format
msgid "Incorrect username or password"
msgstr "Погрешно корисничко име или лозинка"

#: kio_sftp.cpp:1040
#, kde-format
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Не могу да затражим СФТП подсистем. Постарајте се да је СФТП укључен на "
"серверу."

#: kio_sftp.cpp:1045
#, kde-format
msgid "Could not initialize the SFTP session."
msgstr "Не могу да припремим СФТП сесију."

#: kio_sftp.cpp:1049
#, kde-format
msgid "Successfully connected to %1"
msgstr "Успјешно успостављена веза са %1"

#: kio_sftp.cpp:1106
#, kde-format
msgid "Invalid sftp context"
msgstr "Лош СФТП контекст"

#: kio_sftp.cpp:1655
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Не могу да промијеним дозволе за\n"
"%1"
